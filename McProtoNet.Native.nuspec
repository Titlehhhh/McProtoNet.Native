<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>McProtoNet.Native</id>
    <version>$PackageVersion$</version>
    <title>McProtoNet.Native</title>
    <authors>Titlehhhh</authors>
    <owners>Titlehhhh</owners>
    <license type="expression">MIT</license>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <readme>README.md</readme>
    <projectUrl>https://github.com/Titlehhhh/McProtoNet.Native</projectUrl>
    <repository type="git" url="https://github.com/Titlehhhh/McProtoNet.Native.git" branch="main" commit="$Commit$" />
    <description>Prebuilt native libraries for McProtoNet, the .NET Minecraft protocol client. Ships libdeflate $LibdeflateVersion$ as runtimes/{rid}/native for Windows (x64, x86, arm64), Linux glibc (x64, arm64, arm, armv6), Linux musl (x64, arm64) and macOS (universal arm64 + x86_64). No managed code; consumed through P/Invoke with DllImport("libdeflate").</description>
    <summary>Native libdeflate binaries for McProtoNet (Windows, Linux glibc/musl, macOS).</summary>
    <releaseNotes>libdeflate $LibdeflateVersion$. Built from the upstream tag by GitHub Actions; checksums are published on the GitHub release.</releaseNotes>
    <copyright>libdeflate: Copyright Eric Biggers (MIT). Package: Titlehhhh (MIT).</copyright>
    <tags>mcprotonet minecraft native libdeflate deflate zlib gzip compression runtimes win-x64 win-x86 win-arm64 linux-x64 linux-arm64 linux-musl osx</tags>
  </metadata>
</package>
